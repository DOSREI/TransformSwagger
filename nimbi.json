        "responses": {
          "200": {
            "description": "Estrutura JSON com a resposta da a&#231;&#227;o",
            "schema": {
              "$ref": "#/definitions/responseListerrorsRecord2"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "API_GET_USER": {
      "description": "",
