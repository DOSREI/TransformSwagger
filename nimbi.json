          "default": "",
          "description": "Sobrenome do usuario. Tamanho: 100 caracteres"
        },
        "register": {
          "type": "string",
          "default": "",
          "description": "Matricula na empresa do usu&#225;rio. Tamanho: 50 caracteres"
        }
      }
    },
    "API_POST_USER_userUuid": {
      "description": "Estrutura com atributos referente a usuario",
      "type": "object",
      "properties": {
        "uuid": {
          "type": "string",
          "default": "",
          "description": "identificador &#250;nico do usu&#225;rio"
        }
      }
    },
    "API_PUT_USER_STATUS_response": {
      "description": "Estrutura com atributos referente a usuario",
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/definitions/API_PUT_USER_STATUS_userUuid"
        },
        "errors": {
          "type": "array",
