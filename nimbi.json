        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "email",
            "in": "header",
            "required": true,
            "type": "string",
            "default": "",
            "description": "Email do usu&#225;rio"
          },
          {
            "name": "statusCode",
            "in": "path",
            "required": true,
            "type": "string",
            "default": "",
            "description": "Status a ser atualizado no usu&#225;rio. Valores aceitos: active, inactive"
          },
          {
            "name": "accept-language",
            "in": "header",
            "required": false,
            "type": "string",
            "default": "",
            "description": "C&#243;digo da Linguagem que retorna os campos traduzidos (Default = PT): \n* PT -&gt; Portugu&#234;s\n* EN -&gt; Ingl&#234;s\n* ES -&gt; Espanhol\n* FR -&gt; Franc&#234;s"
          }
        ],
        "responses": {
          "200": {
            "description": "Estrutura JSON com a resposta da chamada de atualiza&#231;&#227;o do status do usu&#225;rio",
            "schema": {
              "$ref": "#/definitions/API_PUT_USER_STATUS_response"
            }
          }
        }
      }
    },
    "/v1/users": {
      "get": {
        "tags": [
          "NimbiAccounts"
        ],
        "description": "Busca os usu&#225;rios com acesso ao portal.\n(Pagina&#231;&#227;o baseada no limit)\n\n",
        "operationId": "GET_USER",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": false,
            "type": "string",
            "default": "",
            "description": "Busca o usu&#225;rio por e-mail pelo valor exato que &#233; passado."
          },
          {
            "name": "querySearch",
            "in": "query",
            "required": false,
            "type": "string",
            "default": "",
            "description": "Busca por &quot;name&quot;, &quot;surname&quot; ou &quot;email&quot;"
          },
          {
            "name": "userStatus",
            "in": "query",
            "required": false,
            "type": "string",
            "default": "",
            "description": "Filtro de status do usu&#225;rio: &quot;active&quot; somente usu&#225;rios ativos e &quot;inactive&quot; somente usu&#225;rios inativos, caso vazio busca todos."
          },
          {
            "name": "adminOption",
            "in": "query",
            "required": false,
            "type": "string",
            "default": "",
            "description": "Filtro de usu&#225;rio administrador: &quot;admin&quot; somente usu&#225;rios administradores e &quot;notadmin&quot; somente usu&#225;rios n&#227;o administradores, caso vazio busca todos."
          },
          {
            "name": "register",
            "in": "query",
            "required": false,
            "type": "string",
            "default": "",
            "description": "Busca o usu&#225;rio pela matr&#237;cula pelo valor exato que &#233; passado."
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "type": "string",
            "default": "",
            "description": "Par&#226;metro utilizado para indicar a posi&#231;&#227;o inicial de consulta. Default 0."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "string",
            "default": "",
            "description": "Par&#226;metro utilizado para limitar a quantidade de registros trazidos pela consulta. M&#225;ximo 100. Default 12."
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "type": "string",
            "default": "",
            "description": "Par&#226;metro utilizado para ordenar a consulta. Para essa API utilize 'email', 'name', 'surname', 'isAdmin' e/ou 'updateDate'. Default 'name, surname'"
          },
          {
            "name": "returnFields",
            "in": "query",
            "required": false,
            "type": "string",
            "default": "",
            "description": "Utilizado para definir quais campos da estrutura JSON v&#227;o ser retornados. Passar os mesmos nomes da estrutura JSON separado por virgula (Ex: &quot;user.name,userExt.updatedDate&quot;), caso vazio, retornam os seguintes campos: &quot;user.name,user.email,user.isActive,userExt.uuid,userExt.isAdmin&quot;."
          },
          {
            "name": "accept-language",
            "in": "header",
            "required": false,
            "type": "string",
            "default": "",
            "description": "C&#243;digo da Linguagem que retorna os campos traduzidos (Default = PT): \n* PT -&gt; Portugu&#234;s\n* EN -&gt; Ingl&#234;s\n* ES -&gt; Espanhol\n* FR -&gt; Franc&#234;s"
          }
        ],
        "responses": {
          "200": {
            "description": "Estrutura JSON com a resposta da chamada",
            "schema": {
              "$ref": "#/definitions/API_GET_USER_response"
            }
          }
        }
      }
    },
