{
  "swagger": "2.0",
  "info": {
    "title": "NimbiAccounts",
    "description": "API do Provedor Nimbi - requer os seguintes par&#226;metros headers:\n* ClientAPI_ID (Identifica&#231;&#227;o do Cliente NIMBI);\n* ClientAPI_Key (Chave de acesso NIMBI para o consumo de APIs);\n* companyTaxNumber (Registro Fiscal da empresa que est&#225; executando a&#231;&#227;o - sem m&#225;scara);\n* companyCountryCode (C&#243;digo do Pa&#237;s da empresa que est&#225; executando a&#231;&#227;o. Ex: 'BR').",
    "version": "1"
  },
  "basePath": "/NimbiProviderAPI/rest/NimbiAccounts",
  "schemes": [
    "https"
  ],
  "paths": {
    "/v1/{token}": {
      "get": {
        "tags": [
          "NimbiAccounts"
        ],
        "description": "API para consultar os dados da conta do usu&#225;rio atrav&#233;s do token.",
        "operationId": "GetUserOAuth",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "type": "string",
            "default": "",
            "description": "Chave da autentica&#231;&#227;o"
          },
          {
            "name": "returnFields",
            "in": "query",
            "required": false,
            "type": "string",
            "default": "",
            "description": "Utilizado para definir quais campos da estrutura JSON v&#227;o ser retornados. Passar os mesmos nomes da estrutura JSON separado por virgula (Ex: &quot;uuid,name,surname&quot;), caso vazio, retornam todos os campos."
          },
          {
            "name": "accept-language",
            "in": "header",
            "required": false,
            "type": "string",
            "default": "",
            "description": "C&#243;digo da Linguagem que retorna os campos traduzidos (Default = PT): \n* PT -&gt; Portugu&#234;s\n* EN -&gt; Ingl&#234;s\n* ES -&gt; Espanhol\n* FR -&gt; Franc&#234;s"
          }
        ],
        "responses": {
          "200": {
            "description": "Estrutura JSON com a resposta da chamada de busca da autentica&#231;&#227;o.",
            "schema": {
              "$ref": "#/definitions/StructApiUserByToken"
            }
          }
        }
      }
    },
    "/v1/{userUuid}/preferences": {
      "put": {
        "tags": [
          "NimbiAccounts"
        ],
        "description": "Edita as prefer&#234;ncias de um usu&#225;rio",
        "operationId": "PUT_USER_PREFERENCES",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "userUuid",
            "in": "path",
            "required": true,
            "type": "string",
            "default": "",
            "description": "Identificador unico do usu&#225;rio"
          },
          {
            "name": "request",
            "in": "body",
            "description": "Estrutura JSON necess&#225;ria para a edi&#231;&#227;o das prefer&#234;ncias do usu&#225;rio",
            "required": true,
            "schema": {
              "$ref": "#/definitions/API_User_POST_Preferences_Req"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Estrutura JSON com a resposta da chamada de edi&#231;&#227;o das prefer&#234;ncias do usu&#225;rio.",
            "schema": {
              "$ref": "#/definitions/API_User_POST_Preferences_Resp"
            }
          }
        }
      }
    },
    "/v1/applications": {
      "get": {
        "tags": [
          "NimbiAccounts"
        ],
        "description": "Retorna as aplica&#231;&#245;es do portal.\n(Pagina&#231;&#227;o baseada no limit)\n\n",
        "operationId": "GET_APPLICATIONS",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "type": "integer",
            "x-example": 0,
            "format": "int32",
            "description": "Parametro utilizado para indicar a posicao inicial de consulta. Default 0."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "x-example": 0,
            "format": "int32",
            "description": "Parametro utilizado para limitar a quantidade de registros trazidos pela consulta. M&#225;ximo 100. Default 12."
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "type": "string",
            "default": "",
            "description": "Parametro utilizado para ordenar a consulta. Para essa API utilize 'name' e/ou 'code'. Default 'name'"
          },
          {
            "name": "acceptlanguage",
            "in": "query",
            "required": false,
            "type": "string",
            "default": "",
            "description": "C&#243;digo da Linguagem que retorna os campos traduzidos (Default = PT): \n* PT -&gt; Portugu&#234;s\n* EN -&gt; Ingl&#234;s\n* ES -&gt; Espanhol\n* FR -&gt; Franc&#234;s"
          }
        ],
        "responses": {
          "200": {
            "description": "Estrutura JSON com a resposta da chamada de busca de aplica&#231;&#227;o associada ao cliente",
            "schema": {
              "$ref": "#/definitions/GET_Applications_Response_V2"
            }
          }
        }
      }
    },
    "/v1/hierarchies": {
      "put": {
        "tags": [
          "NimbiAccounts"
        ],
        "description": "Define a hierarquia de um usu&#225;rio baseado no email (email do usu&#225;rio e do parent)",
        "operationId": "PUT_Hierarchies",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "Request",
            "in": "body",
            "description": "Estrutura JSON com a chamada para definir hierarquia de um usu&#225;rio",
            "required": true,
            "schema": {
              "$ref": "#/definitions/PUT_HierarchiesRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Estrutura JSON com a resposta da chamada de busca de hierarquia de um usu&#225;rio",
            "schema": {
              "$ref": "#/definitions/API_UserHierarchy_PUT"
            }
          }
        }
      },
      "get": {
        "tags": [
          "NimbiAccounts"
        ],
        "description": "Busca a hierarquia de um usu&#225;rio baseado no email",
        "operationId": "GET_Hierarchies",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "email",
            "in": "header",
            "required": true,
            "type": "string",
            "default": "",
            "description": "Email do usu&#225;rio"
          },
          {
            "name": "numberOfLevels",
            "in": "query",
            "required": false,
            "type": "integer",
            "x-example": 0,
            "format": "int32",
            "description": "Par&#226;metro utilizado para indicar a quantidade de n&#237;veis desejados no retorno da consulta. Default 3 / M&#225;ximo 50."
          }
        ],
        "responses": {
          "200": {
            "description": "Estrutura JSON com a resposta da chamada de busca de hierarquia de um usu&#225;rio",
            "schema": {
              "$ref": "#/definitions/API_UserHierarchy_GET"
            }
          }
        }
      }
    },
    "/v1/user": {
      "post": {
        "tags": [
          "NimbiAccounts"
        ],
        "description": "Cria usu&#225;rio com acesso ao portal.",
        "operationId": "POST_USER",
