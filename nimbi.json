          },
          {
            "name": "request",
            "in": "body",
            "description": "Estrutura JSON necessaria para a cria&#231;&#227;o do usu&#225;rio",
            "required": true,
            "schema": {
              "$ref": "#/definitions/API_POST_USER_request"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Estrutura JSON com a resposta da chamada de cria&#231;&#227;o do usu&#225;rio",
            "schema": {
              "$ref": "#/definitions/API_POST_USER_response"
            }
          }
        }
      }
    },
    "/v1/user/{userUuid}": {
      "put": {
        "tags": [
          "NimbiAccounts"
        ],
        "description": "Atualiza usu&#225;rio com acesso ao portal.",
        "operationId": "PUT_USER",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "userUuid",
            "in": "path",
            "required": true,
            "type": "string",
            "default": "",
            "description": "Identificador unico do usu&#225;rio"
          },
          {
            "name": "accept-language",
            "in": "header",
            "required": false,
            "type": "string",
            "default": "",
            "description": "C&#243;digo da Linguagem que retorna os campos traduzidos (Default = PT): \n* PT -&gt; Portugu&#234;s\n* EN -&gt; Ingl&#234;s\n* ES -&gt; Espanhol\n* FR -&gt; Franc&#234;s"
          },
          {
            "name": "request",
            "in": "body",
            "description": "",
            "required": true,
            "schema": {
              "$ref": "#/definitions/put_user_request"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Estrutura JSON com a resposta da chamada de atualiza&#231;&#227;o do status do usu&#225;rio",
            "schema": {
              "$ref": "#/definitions/users"
            }
          }
        }
      }
    },
    "/v1/user/{userUuid}/status/{statusCode}": {
      "put": {
        "tags": [
          "NimbiAccounts"
        ],
        "description": "Atualiza o status do usu&#225;rio",
        "operationId": "PUT_USER_STATUS",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "userUuid",
            "in": "path",
            "required": true,
            "type": "string",
            "default": "",
            "description": "Identificador unico do usu&#225;rio"
          },
          {
            "name": "statusCode",
            "in": "path",
            "required": true,
            "type": "string",
            "default": "",
