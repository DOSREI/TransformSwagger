{
  "openapi": "3.0.1",
  "info": {
    "title": "NimbiAccounts",
    "description": "API do Provedor Nimbi - requer os seguintes parâmetros headers:\n* ClientAPI_ID (Identificação do Cliente NIMBI);\n* ClientAPI_Key (Chave de acesso NIMBI para o consumo de APIs);\n* companyTaxNumber (Registro Fiscal da empresa que está executando a ação - sem máscara);\n* companyCountryCode (Código do País da empresa que está executando a ação. Ex: 'BR').",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/NimbiProviderAPI/rest/NimbiAccounts"
    }
  ],
  "tags": [
    {
      "name": "NimbiAccounts"
    }
  ],
  "paths": {
    "/v1/{token}": {
      "get": {
        "tags": [
          "NimbiAccounts"
        ],
        "description": "API para consultar os dados da conta do usuário através do token.",
        "operationId": "GetUserOAuth",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "description": "Chave da autenticação",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "returnFields",
            "in": "query",
            "description": "Utilizado para definir quais campos da estrutura JSON vão ser retornados. Passar os mesmos nomes da estrutura JSON separado por virgula (Ex: \"uuid,name,surname\"), caso vazio, retornam todos os campos.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accept-language",
            "in": "header",
            "description": "Código da Linguagem que retorna os campos traduzidos (Default = PT): \n* PT -> Português\n* EN -> Inglês\n* ES -> Espanhol\n* FR -> Francês",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Estrutura JSON com a resposta da chamada de busca da autenticação.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StructApiUserByToken"
                }
              }
            }
          }
        }
      }
    },
    "/v1/{userUuid}/preferences": {
      "put": {
        "tags": [
          "NimbiAccounts"
        ],
        "description": "Edita as preferências de um usuário",
        "operationId": "PUT_USER_PREFERENCES",
        "parameters": [
          {
            "name": "userUuid",
            "in": "path",
            "description": "Identificador unico do usuário",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Estrutura JSON necessária para a edição das preferências do usuário",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/API_User_POST_Preferences_Req"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Estrutura JSON com a resposta da chamada de edição das preferências do usuário.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/API_User_POST_Preferences_Resp"
                }
              }
            }
          }
        },
        "x-codegen-request-body-name": "request"
      }
    },
    "/v1/applications": {
      "get": {
        "tags": [
          "NimbiAccounts"
        ],
        "description": "Retorna as aplicações do portal.\n(Paginação baseada no limit)",
        "operationId": "GET_APPLICATIONS",
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "description": "Parametro utilizado para indicar a posicao inicial de consulta. Default 0.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Parametro utilizado para limitar a quantidade de registros trazidos pela consulta. Máximo 100. Default 12.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 12
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Parametro utilizado para ordenar a consulta. Para essa API utilize 'name' e/ou 'code'. Default 'name'",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accept-language",
            "in": "header",
            "description": "Código da Linguagem que retorna os campos traduzidos (Default = PT): \n* PT -> Português\n* EN -> Inglês\n* ES -> Espanhol\n* FR -> Francês",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Estrutura JSON com a resposta da chamada de busca de aplicação associada ao cliente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GET_Applications_Response_V2"
                }
              }
            }
          }
        }
      }
    },
    "/v1/hierarchies": {
      "get": {
        "tags": [
          "NimbiAccounts"
        ],
        "description": "Busca a hierarquia de um usuário baseado no email",
        "operationId": "GET_Hierarchies",
        "parameters": [
          {
            "name": "email",
            "in": "header",
            "description": "Email do usuário",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "numberOfLevels",
            "in": "query",
            "description": "Parâmetro utilizado para indicar a quantidade de níveis desejados no retorno da consulta. Default 3 / Máximo 50.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 3
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Estrutura JSON com a resposta da chamada de busca de hierarquia de um usuário",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/API_UserHierarchy_GET"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "NimbiAccounts"
        ],
        "description": "Define a hierarquia de um usuário baseado no email (email do usuário e do parent)",
        "operationId": "PUT_Hierarchies",
        "requestBody": {
          "description": "Estrutura JSON com a chamada para definir hierarquia de um usuário",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PUT_HierarchiesRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Estrutura JSON com a resposta da chamada de busca de hierarquia de um usuário",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/API_UserHierarchy_PUT"
                }
              }
            }
          }
        },
        "x-codegen-request-body-name": "Request"
      }
    },
    "/v1/user": {
      "post": {
        "tags": [
          "NimbiAccounts"
        ],
        "description": "Cria usuário com acesso ao portal.",
        "operationId": "POST_USER",
        "parameters": [
          {
            "name": "accept-language",
            "in": "header",
            "description": "Código da Linguagem que retorna os campos traduzidos (Default = PT)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Estrutura JSON necessaria para a criação do usuário",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/API_POST_USER_request"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Estrutura JSON com a resposta da chamada de criação do usuário",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/API_POST_USER_response"
                }
              }
            }
          }
        },
        "x-codegen-request-body-name": "request"
      }
    },
    "/v1/user/{userUuid}": {
      "put": {
        "tags": [
          "NimbiAccounts"
        ],
        "description": "Atualiza usuário com acesso ao portal.",
        "operationId": "PUT_USER",
        "parameters": [
          {
            "name": "userUuid",
            "in": "path",
            "description": "Identificador unico do usuário",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accept-language",
            "in": "header",
            "description": "Código da Linguagem que retorna os campos traduzidos (Default = PT)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/put_user_request"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Estrutura JSON com a resposta da chamada de atualização do status do usuário",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/users"
                }
              }
            }
          }
        },
        "x-codegen-request-body-name": "request"
      }
    },
    "/v1/user/{userUuid}/status/{statusCode}": {
      "put": {
        "tags": [
          "NimbiAccounts"
        ],
        "description": "Atualiza o status do usuário",
        "operationId": "PUT_USER_STATUS",
        "parameters": [
          {
            "name": "userUuid",
            "in": "path",
            "description": "Identificador unico do usuário",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "statusCode",
            "in": "path",
            "description": "Status a ser atualizado no usuário. Valores aceitos: active, inactive",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accept-language",
            "in": "header",
            "description": "Código da Linguagem que retorna os campos traduzidos (Default = PT)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Estrutura JSON com a resposta da chamada de atualização do status do usuário",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/API_PUT_USER_STATUS_response"
                }
              }
            }
          }
        }
      }
    },
    "/v1/user/status/{statusCode}": {
      "put": {
        "tags": [
          "NimbiAccounts"
        ],
        "description": "Atualiza o status do usuário",
        "operationId": "PUT_USER_STATUSBYEMAIL",
        "parameters": [
          {
            "name": "email",
            "in": "header",
            "description": "Email do usuário",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "statusCode",
            "in": "path",
            "description": "Status a ser atualizado no usuário. Valores aceitos: active, inactive",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accept-language",
            "in": "header",
            "description": "Código da Linguagem que retorna os campos traduzidos (Default = PT)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Estrutura JSON com a resposta da chamada de atualização do status do usuário",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/API_PUT_USER_STATUS_response"
                }
              }
            }
          }
        }
      }
    },
    "/v1/users": {
      "get": {
        "tags": [
          "NimbiAccounts"
        ],
        "description": "Busca os usuários com acesso ao portal.\n(Paginação baseada no limit)",
        "operationId": "GET_USER",
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "description": "Busca o usuário por e-mail pelo valor exato que é passado.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "querySearch",
            "in": "query",
            "description": "Busca por \"name\", \"surname\" ou \"email\"",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userStatus",
            "in": "query",
            "description": "Filtro de status do usuário: \"active\" somente usuários ativos e \"inactive\" somente usuários inativos, caso vazio busca todos.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "adminOption",
            "in": "query",
            "description": "Filtro de usuário administrador: \"admin\" somente usuários administradores e \"notadmin\" somente usuários não administradores, caso vazio busca todos.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "register",
            "in": "query",
            "description": "Busca o usuário pela matrícula pelo valor exato que é passado.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Parâmetro utilizado para indicar a posição inicial de consulta. Default 0.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Parâmetro utilizado para limitar a quantidade de registros trazidos pela consulta. Máximo 100. Default 12.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Parâmetro utilizado para ordenar a consulta. Para essa API utilize 'email', 'name', 'surname', 'isAdmin' e/ou 'updateDate'. Default 'name, surname'",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "returnFields",
            "in": "query",
            "description": "Utilizado para definir quais campos da estrutura JSON vão ser retornados. Passar os mesmos nomes da estrutura JSON separado por virgula (Ex: \"user.name,userExt.updatedDate\"), caso vazio, retornam os seguintes campos: \"user.name,user.email,user.isActive,userExt.uuid,userExt.isAdmin\".",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accept-language",
            "in": "header",
            "description": "Código da Linguagem que retorna os campos traduzidos (Default = PT)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Estrutura JSON com a resposta da chamada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/API_GET_USER_response"
                }
              }
            }
          }
        }
      }
    },
    "/v1/users/plants": {
      "delete": {
        "tags": [
          "NimbiAccounts"
        ],
        "description": "Exclui usuários de uma planta",
        "operationId": "DELETE_Plant_Users",
        "parameters": [
          {
            "name": "plantCode",
            "in": "query",
            "description": "Código da planta.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accept-language",
            "in": "header",
            "description": "Código da Linguagem que retorna os campos traduzidos (Default = PT)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Lista de usuários a excluir da planta.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/API_User_List2"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Estrutura JSON com a resposta da ação",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/responseListerrorsRecord2"
                }
              }
            }
          }
        },
        "x-codegen-request-body-name": "userList"
      }
    }
  },
  "components": {
    "schemas": {
      "API_GET_USER": {
        "type": "object",
        "properties": {
          "userExt": {
            "$ref": "#/components/schemas/API_GET_USER_userExt"
          },
          "user": {
            "$ref": "#/components/schemas/API_GET_USER_user"
          }
        }
      },
      "API_GET_USER_response": {
        "type": "object",
        "properties": {
          "metadata": {
            "$ref": "#/components/schemas/structMetadata"
          },
          "users": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/API_GET_USER"
            }
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/structError"
            }
          }
        }
      },
      "API_GET_USER_user": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome do usuário"
          },
          "email": {
            "type": "string",
            "description": "E-mail do usuário"
          },
          "lastLogin": {
            "type": "string",
            "description": "Último login do usuário",
            "format": "date-time",
            "example": "2014-12-31T23:59:59.938Z"
          },
          "isActive": {
            "type": "boolean",
            "description": "Indica se o usuário está ativo",
            "example": false
          },
          "creationDate": {
            "type": "string",
            "description": "Data de criação do usuário",
            "format": "date-time",
            "example": "2014-12-31T23:59:59.938Z"
          }
        }
      },
      "API_GET_USER_userExt": {
        "type": "object",
        "properties": {
          "surname": {
            "type": "string",
            "description": "Sobrenome do usuário"
          },
          "updateDate": {
            "type": "string",
            "description": "Data de atualização do usuário",
            "format": "date-time",
            "example": "2014-12-31T23:59:59.938Z"
          },
          "uuid": {
            "type": "string",
            "description": "Identificador único do usuário"
          },
          "isAdmin": {
            "type": "boolean",
            "description": "Indica se o usuário é administrador da empresa",
            "example": false
          },
          "register": {
            "type": "string",
            "description": "Matrícula do usuário na empresa"
          }
        }
      },
      "API_POST_USER_request": {
        "required": [
          "user",
          "userExt"
        ],
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/API_POST_USER_user"
          },
          "userExt": {
            "$ref": "#/components/schemas/API_POST_USER_userExt"
          }
        },
        "description": "Estrutura com atributos referente a usuario"
      },
      "API_POST_USER_response": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/API_POST_USER_userUuid"
          },
          "errors": {
            "type": "array",
            "description": "Informações do erro",
            "items": {
              "$ref": "#/components/schemas/structError"
            }
          }
        },
        "description": "Estrutura com atributos referente a usuario"
      },
      "API_POST_USER_user": {
        "required": [
          "email",
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome do usuario. Tamanho: 256 caracteres"
          },
          "email": {
            "type": "string",
            "description": "Email do usuario. Tamanho: 100 caracteres"
          }
        },
        "description": "Estrutura com atributos referente a usuario"
      },
      "API_POST_USER_userExt": {
        "type": "object",
        "properties": {
          "surname": {
            "type": "string",
            "description": "Sobrenome do usuario. Tamanho: 100 caracteres"
          },
          "register": {
            "type": "string",
            "description": "Matricula na empresa do usuário. Tamanho: 50 caracteres"
          }
        },
        "description": "Estrutura com atributos referente a usuario (extensao)"
      },
      "API_POST_USER_userUuid": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string",
            "description": "identificador único do usuário"
          }
        },
        "description": "Estrutura com atributos referente a usuario"
      },
      "API_PUT_USER_STATUS_response": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/API_PUT_USER_STATUS_userUuid"
          },
          "errors": {
            "type": "array",
            "description": "Informações do erro",
            "items": {
              "$ref": "#/components/schemas/structError"
            }
          }
        }
      },
      "API_PUT_USER_STATUS_userUuid": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string",
            "description": "identificador único do usuário"
          }
        }
      },
      "API_User_List2": {
        "type": "object",
        "properties": {
          "users": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/API_User2"
            }
          }
        }
      },
      "API_User_POST_Preferences_Req": {
        "type": "object",
        "properties": {
          "isShowWizard": {
            "type": "boolean",
            "description": "Indica se o usuário está com o wizard habilitado para exibição",
            "example": false
          },
          "locale": {
            "type": "string",
            "description": "Preferência de linguagem definida pelo usuário;"
          },
          "defaultApplication": {
            "type": "string",
            "description": "Aplicação definida para redirecionamento após efetuar o login"
          },
          "allowEmail": {
            "type": "boolean",
            "description": "Indica se o usuário deseja receber email da aplicação",
            "example": false
          },
          "allowNotification": {
            "type": "boolean",
            "description": "Indica se o usuário deseja receber notificações",
            "example": false
          },
          "timezoneCode": {
            "type": "string",
            "description": "Código do timezone"
          },
          "maskCode": {
            "type": "string",
            "description": "Código da máscara numérica ('BRA' ou 'INT')"
          }
        }
      },
      "API_User_POST_Preferences_Resp": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "description": "Lista de erros retornados da operação.",
            "items": {
              "$ref": "#/components/schemas/structError3"
            }
          }
        }
      },
      "API_User2": {
        "type": "object",
        "properties": {
          "Username": {
            "type": "string",
            "description": "Nome do usuário. Length = 250."
          }
        }
      },
      "API_UserHierarchy": {
        "type": "object",
        "properties": {
