{
  "openapi": "3.0.3",
  "info": {
    "title": "MIT044 - Webhooks Protheus para iPaaS/4Ind",
    "version": "1.0.0",
    "description": "Contrato dos endpoints que deverão ser disponibilizados pelo iPaaS para receber eventos originados no TOTVS Protheus e encaminhá-los ao 4Ind. Neste documento, o Protheus atua como cliente HTTP e o iPaaS como servidor. As URLs permanecem provisórias até a definição pelo time do iPaaS. O registro das mensagens na ZZM é independente do envio HTTP: o payload é gravado como saída pendente e será transmitido posteriormente pelo Job responsável. A presença de um webhook neste contrato não significa que seu gatilho, Job ou envio HTTP já esteja implementado no Protheus; consulte a extensão x-protheus-status de cada operação."
  },
  "servers": [
    {
      "url": "https://{hostIpaas}",
      "description": "Servidor receptor de webhooks do iPaaS - endereço a definir",
      "variables": {
        "hostIpaas": {
          "default": "ipaas.exemplo.com.br",
          "description": "Host de homologação ou produção informado pelo time do iPaaS"
        }
      }
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Pedidos de Venda",
      "description": "Follow-up de alterações manuais em pedidos de venda originados no 4Ind"
    },
    {
      "name": "Notas Fiscais de Saída",
      "description": "Eventos de autorização/faturamento e cancelamento de NF-e"
    },
    {
      "name": "Compras",
      "description": "Eventos futuros de pedidos de compra e recebimento de documentos de entrada"
    },
    {
      "name": "Clientes",
      "description": "Eventos futuros de alteração de dados de clientes"
    }
  ],
  "paths": {
    "/webhook/4ind/follow-up/pedidos-venda": {
      "post": {
        "tags": [
          "Pedidos de Venda"
        ],
        "summary": "Receber alterações de pedido de venda",
        "description": "Recebe somente os campos monitorados que foram efetivamente alterados no Protheus. C5_NUM e C5_ZZIDEXT identificam o pedido. Em itens, DELETADO=true indica que o item foi excluído. O endpoint está definido provisoriamente no fonte FollowupPV e poderá ser substituído quando o iPaaS informar a rota definitiva.",
        "operationId": "receberFollowupPedidoVenda",
        "x-contract-status": "provisional_endpoint",
        "x-protheus-status": "payload_e_registro_pendente_na_ZZM_implementados; envio_HTTP_e_Job_pendentes",
        "x-origin": {
          "system": "TOTVS Protheus",
          "trigger": "Alteração manual de pedido originado no 4Ind após comparação do snapshot",
          "entity": "FOLLOWUP_PV"
        },
        "x-codeSamples": [
          {
            "lang": "cURL",
            "label": "Alteração de cabeçalho e item",
            "source": "curl --request POST 'https://ipaas.exemplo.com.br/webhook/4ind/follow-up/pedidos-venda' --header 'Authorization: Bearer SEU_TOKEN' --header 'Content-Type: application/json' --data-raw '{\"C5_NUM\":\"000456\",\"C5_ZZIDEXT\":\"PED-4IND-2026-00123\",\"C5_MENNOTA\":\"PEDIDO ALTERADO NO PROTHEUS\",\"itens\":[{\"C6_ITEM\":\"01\",\"C6_QTDVEN\":2}]}'"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FollowupPedidoVenda"
              },
              "examples": {
                "alteracao": {
                  "summary": "Campos alterados no cabeçalho e no item",
                  "value": {
                    "C5_NUM": "000456",
                    "C5_ZZIDEXT": "PED-4IND-2026-00123",
                    "C5_MENNOTA": "PEDIDO ALTERADO NO PROTHEUS",
                    "itens": [
                      {
                        "C6_ITEM": "01",
                        "C6_QTDVEN": 2
                      }
                    ]
                  }
                },
                "exclusaoItem": {
                  "summary": "Item excluído no Protheus",
                  "value": {
                    "C5_NUM": "000456",
                    "C5_ZZIDEXT": "PED-4IND-2026-00123",
                    "itens": [
                      {
                        "C6_ITEM": "02",
                        "DELETADO": true
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/WebhookRecebido"
          },
          "202": {
            "$ref": "#/components/responses/WebhookAceito"
          },
          "400": {
            "$ref": "#/components/responses/PayloadInvalido"
          },
          "401": {
            "$ref": "#/components/responses/NaoAutorizado"
          },
          "409": {
            "$ref": "#/components/responses/EventoDuplicado"
          },
          "429": {
            "$ref": "#/components/responses/LimiteExcedido"
          },
          "500": {
            "$ref": "#/components/responses/ErroIpaas"
          },
          "503": {
            "$ref": "#/components/responses/IpaasIndisponivel"
          }
        }
      }
    },
    "/webhook/4ind/notas-fiscais/faturamento": {
      "post": {
        "tags": [
          "Notas Fiscais de Saída"
        ],
        "summary": "Receber autorização e faturamento de NF-e",
        "description": "Notifica que uma NF-e vinculada a pedido originado no 4Ind foi autorizada. O XML e o DANFE são enviados codificados em Base64. A rota deverá ser confirmada pelo iPaaS.",
        "operationId": "receberFaturamentoNFe",
        "x-contract-status": "provisional_endpoint",
        "x-protheus-status": "previsto_na_MIT044; gatilho_Job_e_envio_HTTP_pendentes",
        "x-origin": {
          "system": "TOTVS Protheus",
          "trigger": "Autorização da NF-e na SEFAZ",
          "entity": "WEBHOOK_FAT"
        },
        "x-codeSamples": [
          {
            "lang": "cURL",
            "label": "NF-e faturada",
            "source": "curl --request POST 'https://ipaas.exemplo.com.br/webhook/4ind/notas-fiscais/faturamento' --header 'Authorization: Bearer SEU_TOKEN' --header 'Content-Type: application/json' --data-raw '{\"evento\":\"NFE_FATURADA\",\"filial\":\"01\",\"pedido\":\"000456\",\"id_externo\":\"PED-4IND-2026-00123\",\"notaFiscal\":\"000012345\",\"serie\":\"1\",\"chaveNFe\":\"35260912345678000199550010000123451000123456\",\"dataEmissao\":\"2026-09-03\",\"horaEmissao\":\"10:30:00\",\"xmlBase64\":\"BASE64_XML\",\"danfePdfBase64\":\"BASE64_PDF\"}'"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NFeFaturada"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/WebhookRecebido"
          },
          "202": {
            "$ref": "#/components/responses/WebhookAceito"
          },
          "400": {
            "$ref": "#/components/responses/PayloadInvalido"
          },
          "401": {
            "$ref": "#/components/responses/NaoAutorizado"
          },
          "409": {
            "$ref": "#/components/responses/EventoDuplicado"
          },
          "429": {
            "$ref": "#/components/responses/LimiteExcedido"
          },
          "500": {
            "$ref": "#/components/responses/ErroIpaas"
          },
          "503": {
            "$ref": "#/components/responses/IpaasIndisponivel"
          }
        }
      }
    },
