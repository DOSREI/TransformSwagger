  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token Bearer fornecido pelo iPaaS e configurado no Protheus. O valor não deve ser incluído nesta documentação."
      }
    },
    "schemas": {
      "FollowupPedidoVenda": {
        "type": "object",
        "required": [
          "C5_NUM",
          "C5_ZZIDEXT"
        ],
        "description": "Payload dinâmico. Além das chaves do pedido, contém somente os campos C5_ monitorados que foram alterados. O array itens é enviado apenas quando houver inclusão, alteração ou exclusão de itens monitorados.",
        "properties": {
          "C5_NUM": {
            "type": "string",
            "description": "Número do pedido no Protheus, preservando zeros à esquerda.",
            "example": "000456"
          },
          "C5_ZZIDEXT": {
            "type": "string",
            "description": "Identificador original do pedido no 4Ind.",
            "example": "PED-4IND-2026-00123"
          },
          "itens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemFollowupPedidoVenda"
            }
          }
        },
        "additionalProperties": true,
        "x-dynamic-fields": {
          "enabled": true,
          "table": "SC5",
          "acceptedPrefix": "C5_",
          "onlyFieldsOriginallyReceivedFrom4Ind": true,
          "onlyChangedFields": true
        }
      },
      "ItemFollowupPedidoVenda": {
        "type": "object",
        "required": [
          "C6_ITEM"
        ],
        "description": "Item dinâmico contendo C6_ITEM e somente os campos C6_ monitorados que foram alterados. Para item excluído, envia C6_ITEM e DELETADO=true.",
        "properties": {
          "C6_ITEM": {
            "type": "string",
            "example": "01"
          },
          "DELETADO": {
            "type": "boolean",
            "description": "Quando true, informa que o item foi excluído no Protheus."
          }
        },
        "additionalProperties": true,
        "x-dynamic-fields": {
          "enabled": true,
          "table": "SC6",
          "acceptedPrefix": "C6_",
          "onlyFieldsOriginallyReceivedFrom4Ind": true,
          "onlyChangedFields": true
        }
      },
      "NFeFaturada": {
        "type": "object",
        "required": [
          "evento",
          "filial",
          "pedido",
          "id_externo",
          "notaFiscal",
          "serie",
          "chaveNFe",
          "dataEmissao",
          "horaEmissao",
          "xmlBase64",
          "danfePdfBase64"
        ],
        "properties": {
          "evento": {
            "type": "string",
            "enum": [
              "NFE_FATURADA"
            ]
          },
          "filial": {
            "type": "string",
            "example": "01"
          },
          "pedido": {
            "type": "string",
            "example": "000456"
          },
          "id_externo": {
            "type": "string",
            "example": "PED-4IND-2026-00123"
          },
          "notaFiscal": {
            "type": "string",
            "example": "000012345"
          },
          "serie": {
            "type": "string",
            "example": "1"
          },
          "chaveNFe": {
            "type": "string",
            "minLength": 44,
            "maxLength": 44,
            "example": "35260912345678000199550010000123451000123456"
          },
          "dataEmissao": {
            "type": "string",
            "format": "date",
            "example": "2026-09-03"
          },
          "horaEmissao": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d$",
            "example": "10:30:00"
          },
          "xmlBase64": {
            "type": "string",
            "format": "byte",
            "description": "Conteúdo integral do XML autorizado da NF-e em Base64."
          },
          "danfePdfBase64": {
            "type": "string",
            "format": "byte",
            "description": "DANFE em PDF codificado em Base64."
          }
        },
        "additionalProperties": false
      },
      "NFeCancelada": {
        "type": "object",
        "required": [
          "evento",
          "filial",
          "pedido",
          "id_externo",
          "notaFiscal",
          "serie",
          "chaveNFe",
          "dataCancelamento",
          "horaCancelamento"
        ],
        "properties": {
          "evento": {
            "type": "string",
            "enum": [
              "NFE_CANCELADA"
            ]
          },
          "filial": {
            "type": "string",
            "example": "01"
          },
          "pedido": {
            "type": "string",
            "example": "000456"
          },
          "id_externo": {
            "type": "string",
            "example": "PED-4IND-2026-00123"
          },
          "notaFiscal": {
            "type": "string",
            "example": "000012345"
          },
          "serie": {
            "type": "string",
            "example": "1"
          },
          "chaveNFe": {
            "type": "string",
            "minLength": 44,
            "maxLength": 44,
            "example": "35260912345678000199550010000123451000123456"
          },
          "dataCancelamento": {
            "type": "string",
            "format": "date",
            "example": "2026-09-03"
          },
          "horaCancelamento": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d$",
            "example": "11:15:00"
          }
        },
        "additionalProperties": false
      },
      "PedidoCompraEnvelope": {
        "type": "object",
        "required": [
          "PEDIDO_COMPRA"
        ],
        "properties": {
          "PEDIDO_COMPRA": {
            "$ref": "#/components/schemas/PedidoCompra"
          }
        },
        "additionalProperties": false
      },
      "PedidoCompra": {
        "type": "object",
        "required": [
          "C7_ZZIDEXT",
          "C7_NUM",
          "C7_ITEM"
        ],
        "description": "Objeto dinâmico da SC7. A MIT044 determina o envio dos campos existentes no pedido de compra; a relação apresentada é apenas um exemplo.",
        "properties": {
